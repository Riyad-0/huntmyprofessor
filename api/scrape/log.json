dden\" name=\"P3_LINK\" id=\"P3_LINK\" value=\"\"><input type=\"hidden\" data-for=\"P3_LINK\" value=\"KUa4zzoEkSCpFqABoZLuo3PPCpMKumPVdgjaRiSN-9z7kiCOgiX8T2iYZ1bLMDrpYrSBC6laqUdEu34Jz-ZeJg\"></div><div class=\"col col-10 apex-col-auto col-end\" ><button onclick=\"apex.submit({request:&#x27;P3_GO&#x27;,validate:true});\" class=\"t-Button t-Button--hot t-Button--small&#x20;t-Button--padTop\" type=\"button\"  id=\"B104454915871031162\"><span class=\"t-Button-label\">Search</span></button><button onclick=\"apex.submit({request:&#x27;P3_RESET&#x27;,validate:true});\" class=\"t-Button t-Button--hot t-Button--small\" type=\"button\"  id=\"P3_RESET\"><span class=\"t-Button-label\">Reset</span></button></div>\n</div>\n</div><b>Please note:</b> The evaluation data is posted after all evaluation sheets are processed.<br />\n\n     \n   </div>\n   <div class=\"t-Region-buttons t-Region-buttons--bottom\">\n    <div class=\"t-Region-buttons-left\"></div>\n    <div class=\"t-Region-buttons-right\"></div>\n   </div>\n </div>\n</div>\n</div>\n</div><div class=\"row \">\n<div class=\"col col-12 apex-col-auto col-start col-end\" ><div class=\"t-Region t-Region--noPadding t-Region--removeHeader js-removeLandmark t-Region--noBorder t-Region--scrollBody\" id=\"R104453815253936311\"  role=\"region\" aria-label=\"Instructions\" >\n <div class=\"t-Region-header\">\n  <div class=\"t-Region-headerItems t-Region-headerItems--title\">\n    <span class=\"t-Region-headerIcon\"><span class=\"t-Icon \" aria-hidden=\"true\"></span></span>\n    <h2 class=\"t-Region-title\" id=\"R104453815253936311_heading\" data-apex-heading>Instructions</h2>\n  </div>\n  <div class=\"t-Region-headerItems t-Region-headerItems--buttons\"><span class=\"js-maximizeButtonContainer\"></span></div>\n </div>\n <div class=\"t-Region-bodyWrap\">\n   <div class=\"t-Region-buttons t-Region-buttons--top\">\n    <div class=\"t-Region-buttons-left\"></div>\n    <div class=\"t-Region-buttons-right\"></div>\n   </div>\n   <div class=\"t-Region-body\">\n     <div class=\"t-Region-orderBy\"></div>\n     <strong>Instruction:</strong><br />\n        To search for an evaluation, please enter the <b>first few letters of the last name</b> or \n        <b>last name, first few letters of the first name</b> to restrict your query. \n        The field is case insensitive. Then click on the \"<b>Search</b>\" button to proceed.\n    <br /><br />\n    To search by the course or semester, click on the tap.\n<br><br>\n\n<strong>NOTE:</strong> This information has been provided to help you in planning and choosing your\n        courses. It is only one source of information that should be used for this\n        purpose.&nbsp; We recommend that you also review course syllabi, the additional\n        information made available via the Hunter online schedule of classes, and talk\n        to other students.&nbsp; <br><br>\n        When interpreting these data please keep in mind the following: \n<ul type=disc>\n <li class=MsoNormal style='line-height:normal'>Evaluations can vary widely for the\n     same professor and may even differ across sections of the same course. </li>\n <li class=MsoNormal style='line-height:normal'>Not all students complete an\n     evaluation.&nbsp; Students who have withdrawn from a course or are not\n     present on the day of the evaluation are not included in the calculations.\n     </li>\n <li class=MsoNormal style='line-height:normal'>Ratings for course sections with a\n     small number of respondents are not necessarily as reliable as those based\n     on a larger number of students.</li>\n</ul>\n<br>\nIf the report information is not correct, please contact the Faculty/Staff Help Desk \nby phone: (212) 772-HELP or by email: \n<a href=\"mailto:helpdesk@hunter.cuny.edu?subject=Teacher%20Evaluation%20On-Line%20Reports\">\n    helpdesk@hunter.cuny.edu</a>.\n\n     \n   </div>\n   <div class=\"t-Region-buttons t-Region-buttons--bottom\">\n    <div class=\"t-Region-buttons-left\"></div>\n    <div class=\"t-Region-buttons-right\"></div>\n   </div>\n </div>\n</div>\n</div>\n</div>\n</div></div>\n      </main>\n      <footer class=\"t-Footer\" id=\"t_Footer\" role=\"contentinfo\">\n        <div class=\"t-Footer-body\">\n          <div class=\"t-Footer-content\"></div>\n          <div class=\"t-Footer-apex\">\n            <div class=\"t-Footer-version\">Release 1.0 - Built by ICIT - \u00a9 Copyright 2024, 2026, Hunter College. All rights reserved.</div>\n            <div class=\"t-Footer-customize\"></div>\n            \n          </div>\n        </div>\n        <div class=\"t-Footer-top\">\n          <a href=\"#top\" class=\"t-Footer-topButton\" id=\"t_Footer_topButton\" title=\"Start of page\" aria-label=\"Start of page\"><span class=\"a-Icon icon-up-chevron\" aria-hidden=\"true\"></span></a>\n        </div>\n      </footer>\n    </div>\n  </div>\n</div>\n<div class=\"t-Body-inlineDialogs\" id=\"t_Body_inlineDialogs\"></div><input type=\"hidden\" id=\"pPageFormRegionChecksums\" value=\"&#x5B;&#x5D;\">\n<input type=\"hidden\" id=\"pPageItemsRowVersion\" value=\"\" /><input type=\"hidden\" id=\"pPageItemsProtected\" value=\"UDNfTElOSw&#x2F;umSBS0lzyfEIKa3zyctZLrye4t2Ci0m8wNfqKZ-cWZQlkZOaR0NE2cvFYHaHEV_7fFIRowp9_0h3rUIxEdcqKQ\" /></form>\n\n\n<script>\nvar apex_img_dir = \"\\u002Fi\\u002F\";\nvar apex = {env: {APP_USER: \"RR4280\",APP_ID: \"116\",APP_PAGE_ID: \"3\",APP_SESSION: \"12308847563021\",APP_FILES: \"r\\u002Fcls2\\u002F116\\u002Ffiles\\u002Fstatic\\u002Fv5\\u002F\",WORKSPACE_FILES: \"r\\u002Fcls2\\u002Ffiles\\u002Fstatic\\u002Fv1\\u002F\",APEX_VERSION: \"23.2.20\",APEX_BASE_VERSION: \"23.2\"},\nlibVersions:{cropperJs:\"1.5.13\",domPurify:\"3.2.4\",fullcalendar:\"6.1.8\",hammer:\"2.0.8\",jquery:\"3.6.4\",jqueryUi:\"1.13.2\",maplibre:\"4.0.1\",markedJs:\"5.1.2\",prismJs:\"1.30.0\",oraclejet:\"16.0.10\",tinymce:\"6.8.4\",turndown:\"7.2.2\",monacoEditor:\"0.32.1\",lessJs:\"4.1.3\"}};\n</script>\n<script src=\"/i/libraries/apex/minified/desktop_all